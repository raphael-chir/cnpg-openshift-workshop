# Workshop naming and sizing, sourced by the setup scripts. Each value can be overridden from the environment.
# Participant "N" gets: user ${USER_PREFIX}NN, project ${PROJECT_PREFIX}-${USER_PREFIX}NN, cluster ${CLUSTER_PREFIX}-${USER_PREFIX}NN.
# Note: scenarios/ hardcode "workshop-<user>" and "pg-<user>": change the project or cluster prefix there too.
USER_PREFIX="${USER_PREFIX:-user}"
PROJECT_PREFIX="${PROJECT_PREFIX:-workshop}"
CLUSTER_PREFIX="${CLUSTER_PREFIX:-pg}"
PARTICIPANT_COUNT="${PARTICIPANT_COUNT:-15}"
