# Foot Cup Sim, application: PostgREST, the REST API generated from the PostgreSQL schema.
# Rendered by setup/init-workshop.sh with envsubst: only ${CLUSTER_NAME} and ${NAMESPACE} are substituted.
# Not here: the Route, created with "oc create route" (its URL is discovered from OpenShift).
#
apiVersion: apps/v1
kind: Deployment
metadata:
  name: postgrest
  namespace: ${NAMESPACE}
  labels:
    app.kubernetes.io/part-of: foot-cup-sim
spec:
  replicas: 1
  selector:
    matchLabels:
      app: postgrest
  template:
    metadata:
      labels:
        app: postgrest
    spec:
      containers:
        - name: postgrest
          image: docker.io/postgrest/postgrest:v14.1
          ports:
            - name: http
              containerPort: 3000
            - name: admin
              containerPort: 3001
          env:
            # Connection URI of the existing cluster, straight from the secret generated by the operator.
            - name: PGRST_DB_URI
              valueFrom:
                secretKeyRef:
                  name: ${CLUSTER_NAME}-app
                  key: uri
            - name: PGRST_DB_SCHEMAS
              value: public
            # Role used for requests without credentials (here the database owner: a lab simplification).
            - name: PGRST_DB_ANON_ROLE
              value: app
            - name: PGRST_OPENAPI_MODE
              value: follow-privileges
            # Health endpoints (/live and /ready) on a separate port; /ready is OK only when the database answers.
            - name: PGRST_ADMIN_SERVER_PORT
              value: "3001"
          readinessProbe:
            httpGet:
              path: /ready
              port: admin
            periodSeconds: 5
          livenessProbe:
            httpGet:
              path: /live
              port: admin
            periodSeconds: 10
          resources:
            requests:
              cpu: 50m
              memory: 64Mi
            limits:
              memory: 256Mi
          securityContext:
            allowPrivilegeEscalation: false
            capabilities:
              drop: ["ALL"]
            runAsNonRoot: true
            seccompProfile:
              type: RuntimeDefault
---
apiVersion: v1
kind: Service
metadata:
  name: postgrest
  namespace: ${NAMESPACE}
  labels:
    app.kubernetes.io/part-of: foot-cup-sim
spec:
  selector:
    app: postgrest
  ports:
    - name: http
      port: 3000
      targetPort: http
# Swagger UI and the React UI will be added below.
